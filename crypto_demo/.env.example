# Copy ONLY to crypto_demo/.env; configure exact broker symbols including suffix.
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
CRYPTO_BTC_SYMBOL=
CRYPTO_ETH_SYMBOL=
# Prefer Messages endpoints for both routes; relay /v1/messages, DeepSeek official /anthropic/v1/messages.
# No automatic switch of protocol to Chat on failure. Fill your endpoint/models below.
AI1_URL=
AI2_URL=
AI3_URL=
AI1_KEY=
AI2_KEY=
AI3_KEY=
FIB_PA_AI1_MODEL=
FIB_PA_AI2_MODEL=
FIB_PA_AI3_MODEL=
FIB_PA_AI_CONFIDENCE=75
FIB_PA_AI_HTTP_RETRIES=5
FIB_PA_AI_READ_TIMEOUT_RETRIES=0
# Roundtrip estimates: USD/lot, bps; adverse slippage ticks on each side.
# Zero means unknown/unconfigured, never measured free execution.
CRYPTO_COMMISSION_PER_LOT=0
CRYPTO_COMMISSION_BPS=0
CRYPTO_SLIPPAGE_TICKS=0
FIB_PA_AI_MAGIC=260611

# Optional Feishu notifications; actual webhook/signing secret stay in private .env.
FEISHU_NOTIFY_ENABLED=false
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# Explicit raw tick/Kline UTC offset; default0. Match broker clock, update for DST yourself.
CRYPTO_SERVER_UTC_OFFSET_HOURS=0

# Optional exact terminal64.exe path; blank uses MT5 default initialization.
CRYPTO_MT5_PATH=

# Primary route effort/timeout/output limits (effort support depends on chosen endpoint).
FIB_PA_AI1_EFFORT=medium
FIB_PA_AI2_EFFORT=low
FIB_PA_AI3_EFFORT=low
# Optional AI-3 extended-thinking switch: blank preserves provider defaults; disabled explicitly turns it off.
# DeepSeek supports thinking.type=disabled; low effort alone does not turn thinking off.
# A rejected switch is never silently removed. AI-1/AI-2 effort is unaffected.
FIB_PA_AI3_THINKING=
FIB_PA_AI1_TIMEOUT=60
FIB_PA_AI2_TIMEOUT=90
FIB_PA_AI3_TIMEOUT=40
FIB_PA_AI1_MAX_TOKENS=4096
FIB_PA_AI2_MAX_TOKENS=4096
FIB_PA_AI3_MAX_TOKENS=2048
# Optional independent backups. Blank fields inherit that role's primary value.
AI1_BACKUP_URL=
AI1_BACKUP_KEY=
FIB_PA_AI1_BACKUP_MODEL=
FIB_PA_AI1_BACKUP_EFFORT=
FIB_PA_AI1_BACKUP_TIMEOUT=
AI2_BACKUP_URL=
AI2_BACKUP_KEY=
FIB_PA_AI2_BACKUP_MODEL=
FIB_PA_AI2_BACKUP_EFFORT=
FIB_PA_AI2_BACKUP_TIMEOUT=
AI3_BACKUP_URL=
AI3_BACKUP_KEY=
FIB_PA_AI3_BACKUP_MODEL=
FIB_PA_AI3_BACKUP_EFFORT=
FIB_PA_AI3_BACKUP_THINKING=
FIB_PA_AI3_BACKUP_TIMEOUT=
# Primary and backup share each role's output token field above.
# Shared transport budget capped5; same-channel read timeout retries forced0.

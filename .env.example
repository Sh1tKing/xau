AI2_URL=https://pool.gptstore.club/v1/chat/completions
AI3_URL=https://pool.gptstore.club/v1/chat/completions
# Protocol follows each primary/backup URL independently.
# Claude Messages: https://your-relay/v1/messages (top-level system, native response parsing).
# GPT/Grok/DeepSeek Chat: .../chat/completions. Changing URL requires this response-contract-v1 code.
# Strict JSON Schema is attempted first; explicit unsupported-parameter errors downgrade within the shared budget.

AI1_KEY=your_ai1_api_key
AI2_KEY=your_ai2_api_key
AI3_KEY=your_ai3_api_key

# Optional backup for each role. Blank fields inherit that role's primary settings.
# Primary and backup share FIB_PA_AI_HTTP_RETRIES; no switch for a valid NO/REJECT.
AI1_BACKUP_URL=
AI1_BACKUP_KEY=
FIB_PA_AI1_BACKUP_MODEL=
FIB_PA_AI1_BACKUP_EFFORT=
FIB_PA_AI1_BACKUP_TIMEOUT=


MT5_LOGIN=your_mt5_login
MT5_PASSWORD="your_mt5_password"
MT5_SERVER=your_mt5_server
DEEPSEEK_API_KEY="your_deepseek_api_key"
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_M5_MODEL=deepseek-v4-pro
DEEPSEEK_M1_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic/v1/messages
NVDA_SYMBOL=NVDA.NAS
NVDA_LOT_SIZE=0.01
GPTSTORE_API_KEY="your_gptstore_api_key"
GPTSTORE_BASE_URL=https://hapiopen.cc/v1/messages
GPTSTORE_MODEL=gpt-5.5
GPTSTORE_M5_MODEL=gpt-5.5
GPTSTORE_M1_MODEL=gpt-5.5
GPTSTORE_REASONING_EFFORT=xhigh
GPTSTORE_RETRY_REASONING_EFFORT=low
FEISHU_NOTIFY_ENABLED=true
FEISHU_WEBHOOK_URL="https://open.feishu.cn/open-apis/bot/v2/hook/your_webhook_id"
FEISHU_WEBHOOK_SECRET=""
PROTECTION_CLOSE_ALL_LOCAL_GATE=false
FIB_PA_SYMBOL=XAUUSD
FIB_PA_LOT_SIZE=0.01
FIB_PA_MAX_POSITIONS=1
FIB_PA_TIMEFRAME=M5
# 纯本地/旧模式阈值；新三盘analysis_mode的AI请求不要求本地分过线。
# AI质量门槛单独使用FIB_PA_AI_CONFIDENCE，实际服务器以其自己的.env为准。
FIB_PA_CONFIDENCE_THRESHOLD=70
FIB_PA_MAGIC=240610
FIB_PA_ENABLE_TRADING=true
FIB_PA_POLL_SECONDS=0.5
FIB_PA_DEVIATION=30
FIB_PA_GUARDIAN_ENABLED=true
# 新订单冻结分级锁盈；旧仓继续原规则。legacy仅影响之后的新订单。
FIB_PA_GUARDIAN_POLICY=profit_floor_v1
# 金额为账户币种，通常USD；预计净收益包含已知入场费用及平仓费用预留。
FIB_PA_PROFIT_MIN_NET=0.20
FIB_PA_PROFIT_FEE_RESERVE=0.10
FIB_PA_PROFIT_LOCK_INITIAL=0.30
FIB_PA_PROFIT_LOCK_1R=0.40
FIB_PA_PROFIT_LOCK_2R=0.50
FIB_PA_PROFIT_ROOM_ATR=1.0
FIB_PA_PROFIT_ROOM_SPREAD=3.0
FIB_PA_PROFIT_ROOM_ABS=0.50
FIB_PA_PROFIT_ADVANCE_ABS=0.20
FIB_PA_PROFIT_ADVANCE_ATR=0.10
FIB_PA_PROFIT_CONFIRM_SECONDS=1.0
# 空白使用xau_fib_pa_logs/guardian_profit_state.json，重启须保留。
FIB_PA_GUARDIAN_STATE_FILE=
# 以下为旧仓/legacy对照的参数，新锁盈仓不运行旧sigmoid虚拟退出。
FIB_PA_BREAKEVEN_TRIGGER_R=0.8
FIB_PA_BREAKEVEN_TRIGGER_ATR=1.0
FIB_PA_BREAKEVEN_BUFFER_ATR=0.1
FIB_PA_VIRTUAL_CONFIRM_SECONDS=2
FIB_PA_STRUCTURE_EXIT_VOLUME_RATIO=1.2
FIB_PA_REAL_SL_DISASTER_ATR=0.35
FIB_PA_REAL_SL_DISASTER_MIN=1.0
FIB_PA_MIN_SL_MODIFY_ATR=0.1
FIB_PA_MIN_SL_MODIFY_ABS=0.5
FIB_PA_MIN_RR=1.5
FIB_PA_MAX_SL_ATR=2.0
FIB_PA_MAX_SL_ABS=8.0
# 生成止损按两位小数向保护侧取整（BUY向下/SELL向上），取整后仍受8美元上限约束。
# 仅用于M15参考价生成结构止损；三AI实时执行另检查触发侧两份stop_buffer及RR。
FIB_PA_ENTRY_MIN_SL_ATR=0.6
FIB_PA_ENTRY_MIN_SL_ABS=0.8
FIB_PA_H4_HARD_FILTER=false
FIB_PA_AI_ENABLED=true
FIB_PA_AI_ENABLE_TRADING=true
FIB_PA_AI_MAGIC=240611
FIB_PA_AI_CONFIDENCE=65
FIB_PA_AI1_MODEL=gpt-5.5
FIB_PA_AI2_MODEL=gpt-5.5
FIB_PA_AI3_MODEL=gpt-5.5
FIB_PA_AI1_EFFORT=medium
FIB_PA_AI2_EFFORT=low
FIB_PA_AI3_EFFORT=low
FIB_PA_AI1_TIMEOUT=60
FIB_PA_AI2_TIMEOUT=90
FIB_PA_AI3_TIMEOUT=40
FIB_PA_AI_HTTP_RETRIES=5
# Extra same-route read-timeout retries. 0 avoids duplicate upstream generation.
FIB_PA_AI_READ_TIMEOUT_RETRIES=0
# Client total-generation budgets; a truncated response is rejected, never executed.
# Native Claude Messages includes thinking; some relay/native Grok caps only bound visible text.
# If reported generation exceeds this budget, the client stops and pauses that route;
# this does not undo charges or guarantee a server-side reasoning ceiling.
# Token-priced APIs bill actual input/cache/output usage, not the full cap.
# A higher cap can let long thinking/output continue, increasing cost and latency.
FIB_PA_AI1_MAX_TOKENS=4096
FIB_PA_AI2_MAX_TOKENS=4096
FIB_PA_AI3_MAX_TOKENS=2048
# All three roles independently: blank keeps provider defaults; disabled requires model support.
# With disabled, effort is omitted; token limits and strict decision validation remain.
# AI-1 also accepts explicit between_tools on Messages without tools, keeping low/medium/high effort.
# Native Sonnet 5.5 rejects disabled: between_tools disables up-front thinking for that model.
# Relay aliases may differ; blank retains current behavior, unsupported settings fail without removal.
# Known grok-4.5/4.6/4.7 cannot disable reasoning. Leave that route's THINKING blank and set EFFORT explicitly.
# Without an effort Grok defaults to high; low still uses reasoning, it is not a hard token budget.
# Conflicting known Grok configurations skip HTTP and use an existing valid backup, or fail clearly.
FIB_PA_AI1_THINKING=
FIB_PA_AI2_THINKING=
FIB_PA_AI3_THINKING=
FIB_PA_AI_ENTRY_TAKEOVER_SEC=360
FIB_PA_AI3_TAKEOVER_SEC=220
AI1_URL=https://hapiopen.cc/v1/messages
AI2_URL=https://hapiopen.cc/v1/messages
AI3_URL=https://hapiopen.cc/v1/messages
# Protocol follows each primary/backup URL independently.
# Relay Messages: https://your-relay/v1/messages (Claude/GPT/Grok support depends on your provider).
# Official DeepSeek Messages: https://api.deepseek.com/anthropic/v1/messages
# Keep DeepSeek models and keys on the official host; do not send them to another provider.
# Messages uses max_tokens and top-level system; effort is omitted when thinking is disabled.
# Official DeepSeek output_config supports effort only: prompt JSON + strict Python validation, no ignored Schema field.
# Other Messages routes try JSON Schema first; unsupported-parameter recovery shares the same request budget.

AI1_KEY=your_ai1_api_key
AI2_KEY=your_ai2_api_key
AI3_KEY=your_ai3_api_key

# Optional backup for each role. Blank fields inherit that role's primary settings.
# Primary and backup share FIB_PA_AI_HTTP_RETRIES; no switch for a valid NO/REJECT.
AI1_BACKUP_URL=
AI1_BACKUP_KEY=
FIB_PA_AI1_BACKUP_MODEL=
FIB_PA_AI1_BACKUP_EFFORT=
FIB_PA_AI1_BACKUP_TIMEOUT=
# Blank inherits FIB_PA_AI1_THINKING; set disabled for a backup-only switch.
FIB_PA_AI1_BACKUP_THINKING=

AI2_BACKUP_URL=
AI2_BACKUP_KEY=
FIB_PA_AI2_BACKUP_MODEL=
FIB_PA_AI2_BACKUP_EFFORT=
FIB_PA_AI2_BACKUP_TIMEOUT=
# Blank inherits FIB_PA_AI2_THINKING; set disabled for a backup-only switch.
FIB_PA_AI2_BACKUP_THINKING=

AI3_BACKUP_URL=
AI3_BACKUP_KEY=
FIB_PA_AI3_BACKUP_MODEL=
FIB_PA_AI3_BACKUP_EFFORT=
FIB_PA_AI3_BACKUP_TIMEOUT=
# Blank inherits FIB_PA_AI3_THINKING; set disabled for a backup-only switch.
FIB_PA_AI3_BACKUP_THINKING=

# Demo research event/deadline persistence. Blank uses xau_fib_pa_logs/strategy_event_state.json.
# Preserve this file when migrating the same account; run one process only.
# Strategy activation lives in strategies/definitions/*.py, not in this env file.
# region_retest / region_rejection are disabled research definitions by default.
FIB_PA_STRATEGY_STATE_FILE=
